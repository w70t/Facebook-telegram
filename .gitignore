# أسرار وحالة تشغيل — لا تُرفع أبداً
.env
settings.json
settings.json.bak
pending.json
pending.json.bak
*.corrupt-*
sources.json

# جلسات تلغرام (= دخول كامل للحساب)
*.session
*.session-journal

# كوكيز X — كل حساب في ملف باسمه: x_cookies_<username>.json
# النمط القديم (x_cookies.json) لم يكن يطابقها، فكانت جلسات X تُرفع إلى GitHub.
x_cookies*.json
# ملفات الكتابة الذرية قد تبقى بعد SIGKILL/انقطاع الكهرباء وتحوي جلسة كاملة.
.x-cookies-*.tmp
# atomic_write_json قد يترك هذا الملف بعد SIGKILL/انقطاع الكهرباء وفيه أسرار.
.tmp-*.json

downloads/
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/
