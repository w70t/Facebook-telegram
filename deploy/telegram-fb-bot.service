[Unit]
Description=Telegram -> Facebook review bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# عدّل المستخدم والمسار حسب جهازك
User=pi
WorkingDirectory=/home/pi/Facebook-telegram
ExecStart=/home/pi/Facebook-telegram/venv/bin/python main.py
# always: يضمن إعادة التشغيل بعد زر "🔄 تحديث من GitHub"
Restart=always
RestartSec=5

# تقييد أمني — الملفات تحتوي توكن فيسبوك وكلمات مرور X وجلسات تلغرام
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/Facebook-telegram
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
